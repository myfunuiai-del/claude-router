#!/usr/bin/env bash
# Claude Router CLI Management Tool
ROUTER_DIR="$HOME/.gemini/claude-router"
PROXY_SCRIPT="$ROUTER_DIR/proxy_v2.py"
PORT=8999
STATUS_URL="http://127.0.0.1:$PORT/status"
UI_URL="http://127.0.0.1:$PORT/ui"

ensure_cli_environment() {
    # Auto-detect AntiGem / Termux app environment and setup symlinks
    local self_script="$(realpath "${BASH_SOURCE[0]:-$0}" 2>/dev/null || echo "$ROUTER_DIR/crouter")"
    [ -f "$self_script" ] && chmod +x "$self_script" 2>/dev/null
    
    local target_dirs=()
    [ -n "$PREFIX" ] && [ -d "$PREFIX/bin" ] && target_dirs+=("$PREFIX/bin")
    [ -d "$HOME/.local/bin" ] && target_dirs+=("$HOME/.local/bin")
    
    # If in AntiGem environment, ensure standard user/app bin directories
    for p in "/data/user/0/ai.antigem/files/usr/bin" "/data/user/0/ai.antigem/files/home/.local/bin"; do
        if [ -d "$p" ]; then
            local already_in=0
            for d in "${target_dirs[@]}"; do
                [ "$d" = "$p" ] && already_in=1
            done
            [ "$already_in" -eq 0 ] && target_dirs+=("$p")
        fi
    done
    
    for bin_dir in "${target_dirs[@]}"; do
        mkdir -p "$bin_dir" 2>/dev/null
        if [ ! -L "$bin_dir/crouter" ] || [ ! -e "$bin_dir/crouter" ]; then
            ln -sf "$self_script" "$bin_dir/crouter" 2>/dev/null
        fi
        if [ ! -L "$bin_dir/croute" ] || [ ! -e "$bin_dir/croute" ]; then
            ln -sf "$self_script" "$bin_dir/croute" 2>/dev/null
        fi
    done

    # Ensure bundled skills and policies are set up
    setup_bundled_skills_and_policies
}

setup_bundled_skills_and_policies() {
    local skills_source="$ROUTER_DIR/skills"
    local policies_source="$ROUTER_DIR/assets/policies"

    # 1. Sync bundled skills (e.g. svg-generator) to Claude and Gemini skill directories
    if [ -d "$skills_source" ]; then
        for skill_dir in "$skills_source"/*; do
            if [ -d "$skill_dir" ]; then
                local skill_name="$(basename "$skill_dir")"
                local claude_target="$HOME/.claude/skills/$skill_name"
                local gemini_target="$HOME/.gemini/config/skills/$skill_name"

                if [ ! -d "$claude_target" ]; then
                    mkdir -p "$claude_target" 2>/dev/null
                    cp -r "$skill_dir"/* "$claude_target"/ 2>/dev/null
                fi

                if [ ! -d "$gemini_target" ]; then
                    mkdir -p "$gemini_target" 2>/dev/null
                    cp -r "$skill_dir"/* "$gemini_target"/ 2>/dev/null
                fi
            fi
        done
    fi

    # 2. Sync image generation policy to AntiGem memory
    if [ -f "$policies_source/image-generation-policy.md" ]; then
        local memory_target="$HOME/.antigem/memory/global"
        if [ -d "$HOME/.antigem/memory" ]; then
            mkdir -p "$memory_target" 2>/dev/null
            if [ ! -f "$memory_target/image-generation-policy.md" ]; then
                cp "$policies_source/image-generation-policy.md" "$memory_target/" 2>/dev/null
            fi
        fi
    fi

    # 3. Ensure image policy is appended into ~/.claude/CLAUDE.md if not already present
    local claude_md="$HOME/.claude/CLAUDE.md"
    if [ -f "$claude_md" ]; then
        if ! grep -q "svg-generator" "$claude_md" 2>/dev/null; then
            cat << 'EOF' >> "$claude_md"

## Image Generation Policy
- Never use https://image.pollinations.ai/prompt/... for generating or showing images.
- When asked to generate or display an image:
  1. First try regular/native image generation.
  2. If that fails or is unavailable, use Claude and the `svg-generator` skill to create an SVG/vector graphic instead.
EOF
        fi
    fi
}

open_browser() {
    local target_url="$1"
    [ -z "$target_url" ] && target_url="$UI_URL"

    # 1. Preferred: AntiGem In-App MCP Bridge (Jarvis / Browser MCP)
    python3 -c '
import json, os, urllib.request, sys
target = sys.argv[1]
dev_id = "e74b5ede909c4c94"
for conf_path in [
    os.path.expanduser("~/.gemini/antigravity/mcp_config.json"),
    os.path.expanduser("~/.gemini/config/mcp_config.json")
]:
    try:
        if os.path.exists(conf_path):
            with open(conf_path) as f:
                servers = json.load(f).get("mcpServers", {})
                dev_id = (
                    servers.get("jarvis_mcp", {}).get("headers", {}).get("X-Device-Id")
                    or servers.get("browser_mcp", {}).get("headers", {}).get("X-Device-Id")
                    or dev_id
                )
                break
    except Exception:
        pass

def mcp_call(url, name, args):
    req = urllib.request.Request(
        url,
        data=json.dumps({
            "jsonrpc": "2.0",
            "id": 1,
            "method": "tools/call",
            "params": {"name": name, "arguments": args}
        }).encode("utf-8"),
        headers={"Content-Type": "application/json", "X-Device-Id": dev_id}
    )
    with urllib.request.urlopen(req, timeout=2) as resp:
        return resp.status == 200

# Try jarvis_open_url (switches directly to browser tab)
try:
    if mcp_call("http://127.0.0.1:8765/jarvis", "jarvis_open_url", {"url": target, "new_tab": False}):
        sys.exit(0)
except Exception:
    pass

# Try browser_open_url + jarvis_open_screen
try:
    if mcp_call("http://127.0.0.1:8765/browser", "browser_open_url", {"url": target}):
        try:
            mcp_call("http://127.0.0.1:8765/jarvis", "jarvis_open_screen", {"screen": "browser"})
        except Exception:
            pass
        sys.exit(0)
except Exception:
    pass

sys.exit(1)
' "$target_url" >/dev/null 2>&1

    if [ $? -eq 0 ]; then
        echo "[Claude Router] Opened in AntiGem internal browser (via MCP)."
        return 0
    fi

    # 2. Preferred Native App Receiver: AntiGem TermuxOpenReceiver Broadcast
    # Directly delivers the URL to AntiGem internal browser component
    local uid_val="${TERMUX__USER_ID:-0}"
    case "$uid_val" in ''|*[!0-9]*) uid_val=0;; esac

    if [ -x "/system/bin/am" ]; then
        /system/bin/am broadcast --user "$uid_val"             -a android.intent.action.VIEW             -n "ai.antigem/ai.antigem.app.TermuxOpenReceiver"             -d "$target_url" >/dev/null 2>&1
        if [ $? -eq 0 ]; then
            echo "[Claude Router] Opened in AntiGem internal web browser."
            return 0
        fi
    fi

    # 3. Fallbacks
    if command -v termux-open-url >/dev/null 2>&1; then
        termux-open-url "$target_url"
    elif command -v termux-open >/dev/null 2>&1; then
        termux-open "$target_url"
    elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$target_url"
    fi
}

is_running() {
    curl -s --max-time 1 "$STATUS_URL" >/dev/null 2>&1
    return $?
}

start_router() {
    ensure_cli_environment
    if is_running; then
        echo "[Claude Router] Already running on port $PORT."
        if [ -t 1 ]; then
            open_browser "$UI_URL"
        fi
        return 0
    fi
    echo "[Claude Router] Starting router on port $PORT..."
    mkdir -p "$ROUTER_DIR"
    if command -v setsid >/dev/null 2>&1; then
        setsid python3 "$PROXY_SCRIPT" "$PORT" > "$ROUTER_DIR/proxy_v2.log" 2>&1 < /dev/null &
    else
        nohup python3 "$PROXY_SCRIPT" "$PORT" > "$ROUTER_DIR/proxy_v2.log" 2>&1 &
    fi
    
    # Wait for ready (up to 3 seconds)
    for _ in {1..30}; do
        if is_running; then
            echo "[Claude Router] Started successfully! Web UI: http://127.0.0.1:$PORT/ui"
            if [ -t 1 ]; then
                open_browser "$UI_URL"
            fi
            return 0
        fi
        sleep 0.1
    done
    echo "[Claude Router] Failed to start or verify within 3 seconds. Check logs at: $ROUTER_DIR/proxy_v2.log"
    return 1
}

stop_router() {
    echo "[Claude Router] Stopping router on port $PORT..."
    pkill -f "proxy_v2.py $PORT" 2>/dev/null || true
    pkill -f "$PROXY_SCRIPT" 2>/dev/null || true
    sleep 0.5
    if is_running; then
        echo "[Claude Router] Warning: Router still responding."
    else
        echo "[Claude Router] Stopped successfully."
    fi
}

status_router() {
    ensure_cli_environment
    if is_running; then
        echo "[Claude Router] Status: RUNNING on port $PORT (HTTP 200 OK)"
        echo "[Claude Router] Dashboard: http://127.0.0.1:$PORT/ui"
        curl -s "$STATUS_URL" | python3 -m json.tool 2>/dev/null || true
    else
        echo "[Claude Router] Status: STOPPED (Port $PORT not responding)"
    fi
}

# Auto-ensure CLI environment on every execution
ensure_cli_environment

case "$1" in
    start)
        start_router
        ;;
    stop)
        stop_router
        ;;
    restart)
        stop_router
        start_router
        ;;
    status)
        status_router
        ;;
    ui)
        if ! is_running; then
            start_router
        else
            open_browser "$UI_URL"
        fi
        ;;
    *)
        echo "Usage: croute/crouter {start|stop|restart|status|ui}"
        echo "       Default action checks status, starts if offline and opens dashboard."
        if ! is_running; then
            start_router
        else
            status_router
            open_browser "$UI_URL"
        fi
        ;;
esac
