#!/usr/bin/env bash
# Claude Router CLI Management Tool
ROUTER_DIR="$HOME/.gemini/claude-router"
PROXY_SCRIPT="$ROUTER_DIR/proxy_v2.py"
PORT=8999
STATUS_URL="http://127.0.0.1:$PORT/status"
UI_URL="http://127.0.0.1:$PORT/ui"

check_for_updates_cli() {
    python3 -c '
import os, sys
router_dir = os.path.expanduser("~/.gemini/claude-router")
if router_dir not in sys.path:
    sys.path.insert(0, router_dir)
import updater_release_api
info = updater_release_api.check_remote_version()
cur = info.get("current_version")
lat = info.get("latest_version")
upd = info.get("update_available")
print("Current version : " + str(cur))
print("Latest version  : " + str(lat))
if upd:
    print("✨ New update available! Run: crouter update")
else:
    print("✅ C-Router is up to date. You can run: crouter update --force to refresh.")
' || echo "[Claude Router] Could not check updates."
}

apply_update_cli() {
    local force="$1"
    echo "[Claude Router] Checking and applying updates from GitHub..."
    if [ -d "$ROUTER_DIR/.git" ]; then
        git -C "$ROUTER_DIR" config --global --add safe.directory "$ROUTER_DIR" 2>/dev/null || true
        git -C "$ROUTER_DIR" fetch origin main
        git -C "$ROUTER_DIR" reset --hard origin/main || git -C "$ROUTER_DIR" pull --rebase origin main
    else
        local tmp_dir="/data/user/0/ai.antigem/files/usr/tmp/crouter_up_$$"
        rm -rf "$tmp_dir"
        git clone --depth 1 "https://github.com/myfunuiai-del/claude-router.git" "$tmp_dir"
        if [ -d "$tmp_dir" ]; then
            rsync -a --exclude="config.json" --exclude="*.log" --exclude="*.db" "$tmp_dir"/ "$ROUTER_DIR"/ 2>/dev/null || \
            cp -a "$tmp_dir"/* "$ROUTER_DIR"/ 2>/dev/null || true
            rm -rf "$tmp_dir"
        fi
    fi
    chmod +x "$ROUTER_DIR/crouter" "$ROUTER_DIR/install.sh" 2>/dev/null || true
    echo "[Claude Router] Update downloaded! Restarting service..."
    stop_router >/dev/null 2>&1 || true
    start_router
    echo "[Claude Router] Updated successfully!"
}

publish_release_cli() {
    local tag="$1"
    local msg="$2"
    if [ -z "$tag" ]; then
        echo "Usage: crouter release <tag_name> [release_notes]"
        echo "Example: crouter release v2.1.0 'Initial v2.1.0 release with auto-start & updater'"
        return 1
    fi
    [ -z "$msg" ] && msg="Release $tag"

    echo "[Claude Router] Preparing release $tag..."
    local repo_dir="$HOME/storage/downloads/AntiGem/crouter-workspace"
    [ ! -d "$repo_dir" ] && repo_dir="$ROUTER_DIR"

    echo "$tag" > "$ROUTER_DIR/VERSION" 2>/dev/null || true
    [ -d "$repo_dir" ] && echo "$tag" > "$repo_dir/VERSION" 2>/dev/null || true

    if command -v gh >/dev/null 2>&1; then
        echo "[Claude Router] Creating GitHub Release using gh CLI..."
        cd "$repo_dir" 2>/dev/null || cd "$ROUTER_DIR"
        git add -A 2>/dev/null || true
        git commit -m "chore(release): bump to $tag" 2>/dev/null || true
        git tag -a "$tag" -m "$msg" 2>/dev/null || true
        git push origin main --tags 2>/dev/null || git push origin main 2>/dev/null || true
        gh release create "$tag" --title "$tag" --notes "$msg" --repo "myfunuiai-del/claude-router" || true
        echo "✅ Release $tag published successfully to GitHub!"
    else
        echo "❌ gh CLI is not available. Please install gh or tag manually."
    fi
}

uninstall_router() {
    echo "⚠️  WARNING: This will completely uninstall Claude Router:"
    echo "   - Stop the running proxy server (port $PORT)"
    echo "   - Remove Auto-Start hook from ~/.bashrc"
    echo "   - Remove CLI symlinks (crouter / croute)"
    echo "   - Delete $ROUTER_DIR (all configs, logs & state)"
    echo ""
    read -r -p "Step 1/2: Are you sure you want to uninstall? [y/N]: " confirm1
    case "$confirm1" in
        [yY]|[yY][eE][sS]) ;;
        *) echo "Uninstall cancelled."; return 0 ;;
    esac
    echo ""
    read -r -p "Step 2/2 (Final Confirmation): Type UNINSTALL to proceed: " confirm2
    if [ "$confirm2" != "UNINSTALL" ]; then
        echo "Uninstall cancelled."
        return 0
    fi

    echo "[Claude Router] Uninstalling..."
    stop_router >/dev/null 2>&1 || true

    # Remove autostart hook from ~/.bashrc
    python3 -c '
import os, re
bashrc = os.path.expanduser("~/.bashrc")
if os.path.exists(bashrc):
    with open(bashrc, "r", encoding="utf-8", errors="ignore") as f:
        text = f.read()
    text = re.sub(r"\n?# >>> crouter-autostart >>>.*?# <<< crouter-autostart <<<\n?", "\n", text, flags=re.S)
    text = re.sub(r"\n?# Auto-start crouter background service if not running\nif \[ -x \"\$HOME/\.local/bin/crouter\" \].*?fi\n?", "\n", text, flags=re.S)
    with open(bashrc, "w", encoding="utf-8") as f:
        f.write(text.rstrip() + "\n")
' 2>/dev/null || true

    # Remove symlinks
    for bin_dir in "$PREFIX/bin" "$HOME/.local/bin" "/data/user/0/ai.antigem/files/usr/bin" "/data/user/0/ai.antigem/files/home/.local/bin"; do
        rm -f "$bin_dir/crouter" "$bin_dir/croute" 2>/dev/null || true
    done

    # Remove router directory
    rm -rf "$ROUTER_DIR" 2>/dev/null || true
    echo "[Claude Router] Fully uninstalled."
}

ensure_cli_environment() {
    # Auto-detect AntiGem / Termux app environment and setup symlinks
    local self_script="$(realpath "${BASH_SOURCE[0]:-$0}" 2>/dev/null || echo "$ROUTER_DIR/crouter")"
    [ -f "$self_script" ] && chmod +x "$self_script" 2>/dev/null
    
    local target_dirs=()
    [ -n "$PREFIX" ] && [ -d "$PREFIX/bin" ] && target_dirs+=("$PREFIX/bin")
    [ -d "$HOME/.local/bin" ] && target_dirs+=("$HOME/.local/bin")
    
    # If in AntiGem environment, ensure standard user/app bin directories
    for p in "/data/user/0/ai.antigem/files/usr/bin" "/data/user/0/ai.antigem/files/home/.local/bin"; do
        if [ -d "$p" ]; then
            local already_in=0
            for d in "${target_dirs[@]}"; do
                [ "$d" = "$p" ] && already_in=1
            done
            [ "$already_in" -eq 0 ] && target_dirs+=("$p")
        fi
    done
    
    for bin_dir in "${target_dirs[@]}"; do
        mkdir -p "$bin_dir" 2>/dev/null
        if [ ! -L "$bin_dir/crouter" ] || [ ! -e "$bin_dir/crouter" ]; then
            ln -sf "$self_script" "$bin_dir/crouter" 2>/dev/null
        fi
        if [ ! -L "$bin_dir/croute" ] || [ ! -e "$bin_dir/croute" ]; then
            ln -sf "$self_script" "$bin_dir/croute" 2>/dev/null
        fi
    done

    # Ensure bundled skills and policies are set up
    setup_bundled_skills_and_policies
}

setup_bundled_skills_and_policies() {
    local skills_source="$ROUTER_DIR/skills"
    local policies_source="$ROUTER_DIR/assets/policies"

    # 1. Sync bundled skills (e.g. svg-generator) to Claude and Gemini skill directories
    if [ -d "$skills_source" ]; then
        for skill_dir in "$skills_source"/*; do
            if [ -d "$skill_dir" ]; then
                local skill_name="$(basename "$skill_dir")"
                local claude_target="$HOME/.claude/skills/$skill_name"
                local gemini_target="$HOME/.gemini/config/skills/$skill_name"

                if [ ! -d "$claude_target" ]; then
                    mkdir -p "$claude_target" 2>/dev/null
                    cp -r "$skill_dir"/* "$claude_target"/ 2>/dev/null
                fi

                if [ ! -d "$gemini_target" ]; then
                    mkdir -p "$gemini_target" 2>/dev/null
                    cp -r "$skill_dir"/* "$gemini_target"/ 2>/dev/null
                fi
            fi
        done
    fi

    # 2. Sync image generation policy to AntiGem memory
    if [ -f "$policies_source/image-generation-policy.md" ]; then
        local memory_target="$HOME/.antigem/memory/global"
        if [ -d "$HOME/.antigem/memory" ]; then
            mkdir -p "$memory_target" 2>/dev/null
            if [ ! -f "$memory_target/image-generation-policy.md" ]; then
                cp "$policies_source/image-generation-policy.md" "$memory_target/" 2>/dev/null
            fi
        fi
    fi

    # 3. Ensure image policy is appended into ~/.claude/CLAUDE.md if not already present
    local claude_md="$HOME/.claude/CLAUDE.md"
    if [ -f "$claude_md" ]; then
        if ! grep -q "svg-generator" "$claude_md" 2>/dev/null; then
            cat << 'EOF' >> "$claude_md"

## Image Generation Policy
- Never use https://image.pollinations.ai/prompt/... for generating or showing images.
- When asked to generate or display an image:
  1. First try regular/native image generation.
  2. If that fails or is unavailable, use Claude and the `svg-generator` skill to create an SVG/vector graphic instead.
EOF
        fi
    fi
}

open_browser() {
    local target_url="$1"
    [ -z "$target_url" ] && target_url="$UI_URL"

    # 1. Preferred: AntiGem In-App MCP Bridge (Jarvis / Browser MCP)
    python3 -c '
import json, os, urllib.request, sys
target = sys.argv[1]
dev_id = "e74b5ede909c4c94"
for conf_path in [
    os.path.expanduser("~/.gemini/antigravity/mcp_config.json"),
    os.path.expanduser("~/.gemini/config/mcp_config.json")
]:
    try:
        if os.path.exists(conf_path):
            with open(conf_path) as f:
                servers = json.load(f).get("mcpServers", {})
                dev_id = (
                    servers.get("jarvis_mcp", {}).get("headers", {}).get("X-Device-Id")
                    or servers.get("browser_mcp", {}).get("headers", {}).get("X-Device-Id")
                    or dev_id
                )
                break
    except Exception:
        pass

def mcp_call(url, name, args):
    req = urllib.request.Request(
        url,
        data=json.dumps({
            "jsonrpc": "2.0",
            "id": 1,
            "method": "tools/call",
            "params": {"name": name, "arguments": args}
        }).encode("utf-8"),
        headers={"Content-Type": "application/json", "X-Device-Id": dev_id}
    )
    with urllib.request.urlopen(req, timeout=2) as resp:
        return resp.status == 200

# Try jarvis_open_url (switches directly to browser tab)
try:
    if mcp_call("http://127.0.0.1:8765/jarvis", "jarvis_open_url", {"url": target, "new_tab": False}):
        sys.exit(0)
except Exception:
    pass

# Try browser_open_url + jarvis_open_screen
try:
    if mcp_call("http://127.0.0.1:8765/browser", "browser_open_url", {"url": target}):
        try:
            mcp_call("http://127.0.0.1:8765/jarvis", "jarvis_open_screen", {"screen": "browser"})
        except Exception:
            pass
        sys.exit(0)
except Exception:
    pass

sys.exit(1)
' "$target_url" >/dev/null 2>&1

    if [ $? -eq 0 ]; then
        echo "[Claude Router] Opened in AntiGem internal browser (via MCP)."
        return 0
    fi

    # 2. Preferred Native App Receiver: AntiGem TermuxOpenReceiver Broadcast
    # Directly delivers the URL to AntiGem internal browser component
    local uid_val="${TERMUX__USER_ID:-0}"
    case "$uid_val" in ''|*[!0-9]*) uid_val=0;; esac

    if [ -x "/system/bin/am" ]; then
        /system/bin/am broadcast --user "$uid_val"             -a android.intent.action.VIEW             -n "ai.antigem/ai.antigem.app.TermuxOpenReceiver"             -d "$target_url" >/dev/null 2>&1
        if [ $? -eq 0 ]; then
            echo "[Claude Router] Opened in AntiGem internal web browser."
            return 0
        fi
    fi

    # 3. Fallbacks
    if command -v termux-open-url >/dev/null 2>&1; then
        termux-open-url "$target_url"
    elif command -v termux-open >/dev/null 2>&1; then
        termux-open "$target_url"
    elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$target_url"
    fi
}

is_running() {
    curl -s --max-time 1 "$STATUS_URL" >/dev/null 2>&1
    return $?
}

start_router() {
    ensure_cli_environment
    if is_running; then
        echo "[Claude Router] Already running on port $PORT."
        if [ -t 1 ]; then
            open_browser "$UI_URL"
        fi
        return 0
    fi
    echo "[Claude Router] Starting router on port $PORT..."
    mkdir -p "$ROUTER_DIR"
    if command -v setsid >/dev/null 2>&1; then
        setsid python3 "$PROXY_SCRIPT" "$PORT" > "$ROUTER_DIR/proxy_v2.log" 2>&1 < /dev/null &
    else
        nohup python3 "$PROXY_SCRIPT" "$PORT" > "$ROUTER_DIR/proxy_v2.log" 2>&1 &
    fi
    
    # Wait for ready (up to 3 seconds)
    for _ in {1..30}; do
        if is_running; then
            echo "[Claude Router] Started successfully! Web UI: http://127.0.0.1:$PORT/ui"
            python3 -c 'import sys, os; sys.path.insert(0, os.path.expanduser("~/.gemini/claude-router")); import tool_manager; tool_manager.auto_start_enabled_tools()' >/dev/null 2>&1 &
            if [ -t 1 ]; then
                open_browser "$UI_URL"
            fi
            return 0
        fi
        sleep 0.1
    done
    echo "[Claude Router] Failed to start or verify within 3 seconds. Check logs at: $ROUTER_DIR/proxy_v2.log"
    return 1
}

stop_router() {
    echo "[Claude Router] Stopping router on port $PORT..."
    pkill -f "proxy_v2.py $PORT" 2>/dev/null || true
    pkill -f "$PROXY_SCRIPT" 2>/dev/null || true
    sleep 0.5
    if is_running; then
        echo "[Claude Router] Warning: Router still responding."
    else
        echo "[Claude Router] Stopped successfully."
    fi
}

status_router() {
    ensure_cli_environment
    if is_running; then
        echo "[Claude Router] Status: RUNNING on port $PORT (HTTP 200 OK)"
        echo "[Claude Router] Dashboard: http://127.0.0.1:$PORT/ui"
        curl -s "$STATUS_URL" | python3 -m json.tool 2>/dev/null || true
    else
        echo "[Claude Router] Status: STOPPED (Port $PORT not responding)"
    fi
}

# Auto-ensure CLI environment on every execution
ensure_cli_environment

case "$1" in
    start)
        start_router
        ;;
    stop)
        stop_router
        ;;
    restart)
        stop_router
        start_router
        ;;
    status)
        status_router
        ;;
    ui)
        if ! is_running; then
            start_router
        else
            open_browser "$UI_URL"
        fi
        ;;
    check-update)
        check_for_updates_cli
        ;;
    update)
        apply_update_cli "$2"
        ;;
    release)
        publish_release_cli "$2" "$3"
        ;;
    uninstall)
        uninstall_router
        ;;
    tools)
        shift
        python3 -c '
import sys, json, os
sys.path.insert(0, os.path.expanduser("~/.gemini/claude-router"))
import tool_manager

args = sys.argv[1:]
if not args or args[0] == "list":
    tools = tool_manager.list_tools_with_status()
    print("=== crouter API Tools ===")
    for t in tools:
        inst = "Installed" if t["installed"] else "Not Installed"
        pid_val = t.get("pid")
        run = f"Running (PID {pid_val})" if t["running"] else "Stopped"
        tid = t["id"]
        tname = t["name"]
        tport = t["default_port"]
        print(f"- {tid}: {tname} [{inst} | {run}] (Default Port: {tport})")
elif len(args) >= 2:
    action = args[0]
    tool_id = args[1]
    port = int(args[2]) if len(args) >= 3 and args[2].isdigit() else None
    res = tool_manager.run_tool_action(tool_id, action, port=port)
    print(json.dumps(res, indent=2))
else:
    print("Usage: crouter tools {list|install|uninstall|start|stop|status|check|update} <tool_id> [port]")
' "$@"
        ;;
    *)
        echo "Usage: croute/crouter {start|stop|restart|status|ui|check-update|update|release|uninstall|tools}"
        echo "       Default action checks status, starts if offline and opens dashboard."
        if ! is_running; then
            start_router
        else
            status_router
            open_browser "$UI_URL"
        fi
        ;;
esac
